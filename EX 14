moves = {"M1":[6,9,7], "M2":[4,8,10], "M3":[7,5,12]}
alpha, best_value, best_move = float("-inf"), float("-inf"), None
scored = 0
for move, scores in moves.items():
    beta, value = float("inf"), float("inf")
    for i, score in enumerate(scores):
        scored += 1
        value = min(value, score)
        beta = min(beta, value)
        if beta <= alpha:
            print(move, "skipped:", scores[i+1:])
            break
    print(move, "value:", value)
    if value > best_value:
        best_value, best_move = value, move
    alpha = max(alpha, best_value)
print("Best move:", best_move, "| Value:", best_value)
print("Positions scored:", scored, "of 9")
