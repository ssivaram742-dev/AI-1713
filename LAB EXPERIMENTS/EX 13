
# Alpha-Beta Pruning Algorithm

def alpha_beta(depth, node, maximizing, values,
               alpha, beta, max_depth):

    if depth == max_depth:
        return values[node]

    if maximizing:
        best = float('-inf')

        for i in range(2):
            value = alpha_beta(
                depth + 1, node * 2 + i, False,
                values, alpha, beta, max_depth
            )
            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                break  # Beta pruning

        return best

    else:
        best = float('inf')

        for i in range(2):
            value = alpha_beta(
                depth + 1, node * 2 + i, True,
                values, alpha, beta, max_depth
            )
            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                break  # Alpha pruning

        return best


# Leaf node values of the game tree
values = [3, 5, 6, 9, 1, 2, 0, -1]

max_depth = 3

result = alpha_beta(
    0, 0, True, values,
    float('-inf'), float('inf'), max_depth
)

print("Optimal value:", result)
