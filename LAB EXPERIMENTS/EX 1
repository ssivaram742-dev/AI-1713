
import heapq

# Goal state
GOAL = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

# Manhattan distance heuristic
def heuristic(state):
    distance = 0

    for i, tile in enumerate(state):
        if tile != 0:
            goal_index = tile - 1
            distance += abs(i // 3 - goal_index // 3)
            distance += abs(i % 3 - goal_index % 3)

    return distance


# Generate possible next states
def get_neighbors(state):
    neighbors = []
    zero = state.index(0)
    row, col = zero // 3, zero % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_pos = new_row * 3 + new_col

            new_state = list(state)
            new_state[zero], new_state[new_pos] = (
                new_state[new_pos], new_state[zero]
            )

            neighbors.append(tuple(new_state))

    return neighbors


# Check whether the puzzle is solvable
def is_solvable(state):
    tiles = [x for x in state if x != 0]
    inversions = 0

    for i in range(len(tiles)):
        for j in range(i + 1, len(tiles)):
            if tiles[i] > tiles[j]:
                inversions += 1

    return inversions % 2 == 0


# A* search algorithm
def solve(start):
    if not is_solvable(start):
        print("The puzzle is not solvable.")
        return

    # Priority queue: (f, g, state)
    # f = g + h
    pq = [(heuristic(start), 0, start)]
    parent = {start: None}
    cost = {start: 0}

    while pq:
        f, g, current = heapq.heappop(pq)

        if g != cost[current]:
            continue

        if current == GOAL:
            path = []

            while current is not None:
                path.append(current)
                current = parent[current]

            path.reverse()

            print("Solution found in", len(path) - 1, "moves:")
            for state in path:
                print(state[0:3])
                print(state[3:6])
                print(state[6:9])
                print()
            return

        for neighbor in get_neighbors(current):
            new_cost = g + 1

            if new_cost < cost.get(neighbor, float("inf")):
                cost[neighbor] = new_cost
                parent[neighbor] = current

                priority = new_cost + heuristic(neighbor)
                heapq.heappush(
                    pq, (priority, new_cost, neighbor)
                )

    print("No solution found.")


# Main program
print("Enter the initial puzzle row by row (use 0 for blank):")
values = []

for i in range(3):
    values.extend(map(int, input().split()))

if len(values) != 9 or set(values) != set(range(9)):
    print("Invalid input! Enter numbers 0 to 8 exactly once.")
else:
    solve(tuple(values))
